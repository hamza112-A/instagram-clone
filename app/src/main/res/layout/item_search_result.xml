<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/search_profile_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/profile_placeholder"
        android:contentDescription="@string/profile_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/action_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/search_follow_button"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Follow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/follow_button_inactive"
            android:textAllCaps="false"
            android:paddingHorizontal="16dp"
            android:minWidth="80dp"/>

        <Button
            android:id="@+id/search_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Reject"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/follow_button_inactive"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="16dp"
            android:minWidth="80dp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/search_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="username"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/search_profile_image"
        app:layout_constraintTop_toTopOf="@id/search_profile_image"
        app:layout_constraintEnd_toStartOf="@id/action_buttons_container" />

    <TextView
        android:id="@+id/search_full_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textSize="13sp"
        android:textColor="@color/text_gray"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/search_profile_image"
        app:layout_constraintTop_toBottomOf="@id/search_username"
        app:layout_constraintEnd_toStartOf="@id/action_buttons_container" />

</androidx.constraintlayout.widget.ConstraintLayout>