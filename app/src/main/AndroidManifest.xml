<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Phase 6: Push Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SociallyApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.i220968_i228810">


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.i220968_i228810">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />

        <activity
            android:name=".LoadingActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />


        <activity
            android:name=".QuickLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".MainFeedActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".DiscoverFeedActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".SearchFeedActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".InboxActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".SelectUserActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".PersonalMessageActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".VideoCallActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".VoiceCallActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".NotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".HighlightActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".UploadPhotoActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />

        <activity
            android:name=".posts.CreatePostActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />

        <activity
            android:name=".posts.CommentsActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".OtherPersonStoryActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".AddStoryActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".MyStoryViewActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".OtherPersonProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <!-- Phase 4 & 7: Follow System and Search -->
        <activity
            android:name=".search.UserSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".follow.FollowersListActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <activity
            android:name=".follow.FollowingListActivity"
            android:exported="false"
            android:theme="@style/Theme.I210575.NoActionBar" />
            
        <!-- Phase 6: Firebase Cloud Messaging -->
        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
            
    </application>

</manifest>